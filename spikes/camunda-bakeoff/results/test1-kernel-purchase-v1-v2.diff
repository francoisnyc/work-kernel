--- kernel/types/purchase.v1.yaml	2026-11-24 02:05:57.533595365 +0000
+++ kernel/types-v2/purchase.v2.yaml	2026-11-24 02:05:57.533595365 +0000
@@ -6,7 +6,8 @@
 #     manager_review with f_manager set by the kernel, never by a person.
 #   - Under 1,000 the manager approves or rejects. From 1,000 the manager's
 #     approval sends it to the finance queue; any finance member claims it
-#     (finance_review) and decides.
+#     (finance_review) and decides. Over 5,000, finance's approval sends it
+#     to the CFO (cfo_review), who decides (v2: the owner's change).
 #   - The agent (agent:prep-bot, role preparer) writes only the three
 #     preparation fields; no move names it. Once submitted, what is being
 #     approved (amount, vendor, cost centre, justification) is frozen.
@@ -14,7 +15,7 @@
 #     the vendor standing in for the ERP's customer); rejected, the
 #     requester is told (email.notify) and the reason is on the Item.
 id: purchase
-version: 1
+version: 2
 initial_state: draft
 
 fields:
@@ -41,6 +42,9 @@
   - id: finance_review
     category: active
     frozen: [f_amount, f_vendor, f_cost_centre, f_justification, f_manager]
+  - id: cfo_review
+    category: waiting
+    frozen: [f_amount, f_vendor, f_cost_centre, f_justification, f_manager, f_claimed_by]
   - id: approved
     category: done
     frozen: [f_amount, f_vendor, f_cost_centre, f_justification, f_manager, f_claimed_by, f_summary, f_policy, f_flags, f_reason]
@@ -61,8 +65,12 @@
   # Finance: claim from the shared queue, hand back, decide.
   - {from: finance_queue,  to: finance_review, allowed: ['role:finance'], except: [creator], required: [f_claimed_by]}
   - {from: finance_review, to: finance_queue,  allowed: ['role:finance'], clears: [f_claimed_by]}
-  - {from: finance_review, to: approved,       allowed: ['role:finance'], except: [creator]}
+  - {from: finance_review, to: approved,       allowed: ['role:finance'], except: [creator], guard: 'f_amount <= 5000'}
+  - {from: finance_review, to: cfo_review,     allowed: ['role:finance'], except: [creator], guard: 'f_amount > 5000'}
   - {from: finance_review, to: rejected,       allowed: ['role:finance'], except: [creator], required: [f_reason]}
+  # The CFO, over 5,000.
+  - {from: cfo_review,     to: approved,       allowed: ['role:cfo'],     except: [creator]}
+  - {from: cfo_review,     to: rejected,       allowed: ['role:cfo'],     except: [creator], required: [f_reason]}
 
 hooks:
   - id: manager_check
