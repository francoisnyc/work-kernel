{
  "connector": "crm",
  "major": 1,
  "name": "get_plan",
  "description": "Looks up the plan a customer is on in the CRM.",
  "kinds": ["enrich"],
  "inputs": ["customerId"],
  "inputSchema": {
    "type": "object",
    "properties": {
      "customerId": {"type": "string", "description": "The customer's ID in the CRM.", "x-pli-trust": "any"}
    }
  },
  "outputs": ["plan"],
  "outputSchema": {
    "type": "object",
    "properties": {
      "plan": {"type": "string", "enum": ["free", "pro", "enterprise"], "description": "The customer's plan."}
    }
  },
  "sideEffects": "none",
  "async": "forbidden",
  "risk": "low"
}
